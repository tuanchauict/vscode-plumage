{
  "name": "plumage",
  "displayName": "Plumage",
  "description": "Automatically colors the title bar, activity bar, side bar, and status bar based on a hash of the workspace path. Theme-aware.",
  "version": "0.0.5",
  "publisher": "tuanchauict",
  "license": "MIT",
  "keywords": [
    "color",
    "colour",
    "theme",
    "workspace",
    "window",
    "title bar",
    "activity bar",
    "side bar",
    "status bar",
    "peacock",
    "multi-window",
    "identify"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuanchauict/vscode-plumage.git"
  },
  "homepage": "https://github.com/tuanchauict/vscode-plumage#readme",
  "bugs": {
    "url": "https://github.com/tuanchauict/vscode-plumage/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "plumage.refresh",
        "title": "Plumage: Refresh Colors"
      },
      {
        "command": "plumage.clear",
        "title": "Plumage: Clear Colors"
      },
      {
        "command": "plumage.shuffle",
        "title": "Plumage: Shuffle (next color)"
      },
      {
        "command": "plumage.pick",
        "title": "Plumage: Pick Color..."
      },
      {
        "command": "plumage.setPalette",
        "title": "Plumage: Set Palette..."
      }
    ],
    "configuration": {
      "title": "Plumage",
      "properties": {
        "plumage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic colorization based on workspace path."
        },
        "plumage.hueOffset": {
          "type": "integer",
          "default": 0,
          "description": "Offset added to the hash-derived color index. Bumped by Shuffle / Pick Color."
        },
        "plumage.palette": {
          "type": "string",
          "enum": ["auto", "dim", "light", "vibrant", "contrast"],
          "enumDescriptions": [
            "Follow the active VS Code theme: dim chrome on dark themes, light chrome on light themes.",
            "Monokai-flavored dim chrome.",
            "Soft, pastel light chrome.",
            "Bold, saturated chrome with strong hue presence.",
            "High-contrast chrome with near-black side bar and bright accents."
          ],
          "default": "auto",
          "description": "Which chrome palette to use."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
